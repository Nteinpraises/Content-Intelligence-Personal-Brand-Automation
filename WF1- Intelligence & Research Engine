    {
      "parameters": {
        "jsCode": "\nconst today = $now.toFormat('yyyy-MM-dd');\nconst recent = $('Get Recent Calendar').all().map(i => i.json).filter(r => r && r.id);\nconst audiences = $('Get Audiences').all().map(a => a.json).filter(a => a && a.id);\nconst pillars = $('Get Pillars').all().map(p => p.json).filter(p => p && p.id);\n\nconst existing = recent.find(r => (r.date || '').slice(0,10) === today);\nif (existing) {\n  return [{ json: {\n    exists: true,\n    calendar_id: existing.id,\n    audience_id: existing.audience_id || null,\n    pillar_id: existing.pillar_id || null,\n    audience_name: existing.audience_name || null,\n    pillar_name: existing.pillar_name || null,\n    objective: existing.objective || 'Educate and build authority',\n    date: today,\n  }}];\n}\n\nconst lastAudience = recent.length ? recent[0].audience_name : null;\nconst lastPillar = recent.length ? recent[0].pillar_name : null;\n\nfunction pickLeastUsed(list, key, avoid) {\n  const counts = list.map(item => {\n    const name = item.name;\n    let idx = recent.findIndex(r => r[key] === name);\n    if (idx === -1) idx = 999;\n    return { item, staleness: idx, name };\n  });\n  const filtered = counts.filter(c => c.name !== avoid);\n  const pool = filtered.length ? filtered : counts;\n  pool.sort((a, b) => b.staleness - a.staleness);\n  return pool[0].item;\n}\n\nconst audience = pickLeastUsed(audiences, 'audience_name', lastAudience);\nconst pillar = pickLeastUsed(pillars, 'pillar_name', lastPillar);\n\nreturn [{ json: {\n  exists: false,\n  calendar_id: null,\n  audience_id: audience.id,\n  pillar_id: pillar.id,\n  audience_name: audience.name,\n  pillar_name: pillar.name,\n  objective: 'Educate and build authority',\n  date: today,\n}}];\n"
      },
