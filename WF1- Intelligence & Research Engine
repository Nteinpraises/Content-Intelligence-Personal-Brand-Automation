        "jsCode": "\nconst items = [];\nfor (const it of $input.all()) {\n  const resp = it.json || {};\n  const results = resp.results || [];\n  for (const r of results) {\n    if (!r.url && !r.title) continue;\n    const content = r.content || '';\n    items.push({ json: {\n      title: r.title || '',\n      url: r.url || '',\n      source: r.title || '',\n      published_date: r.published_date || null,\n      summary: content.slice(0, 800),\n      content: content,\n      category: '',\n    }});\n  }\n}\nreturn items;\n"
