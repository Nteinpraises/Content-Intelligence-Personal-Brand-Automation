    {
      "parameters": {
        "jsCode": "\nfunction hashOf(str) {\n  let h = 0;\n  const s = String(str || '');\n  for (let i = 0; i < s.length; i++) { h = (h * 31 + s.charCodeAt(i)) | 0; }\n  return 'h' + (h >>> 0).toString(16);\n}\n\nconst existing = $('Get Existing Research').all()\n  .map(i => i.json && i.json.hash)\n  .filter(Boolean);\nconst existingSet = new Set(existing);\n\nconst seen = new Set();\nconst newItems = [];\nfor (const it of $input.all()) {\n  const r = it.json || {};\n  if (!r.url && !r.title) continue;\n  const hash = hashOf((r.url || '') + '|' + (r.title || ''));\n  if (existingSet.has(hash) || seen.has(hash)) continue;\n  seen.add(hash);\n  newItems.push({\n    title: r.title || '',\n    url: r.url || '',\n    source: r.source || '',\n    published_date: r.published_date || null,\n    summary: r.summary || '',\n    content: r.content || '',\n    category: r.category || '',\n    hash,\n  });\n}\n\nconst capped = newItems.slice(0, 3);\nreturn [{ json: { count: capped.length, newItems: capped } }];\n"
      },
